%% IRON COUNCIL v2.0 — Full System Architecture
%% BDI Cognitive Architecture with Separation of Powers

graph TD
    User["User / Chairman"] -->|Input| EventBus["Event Bus (Async Pub/Sub)"]
    Heartbeat["Heartbeat / Clock"] -->|Tick| EventBus

    subgraph "THE HIVE MIND — Async OODA Loops"
        EventBus -->|Broadcast| OODA["Agent OODA Loop (Parallel)"]
        OODA -->|Observe/Orient| Recall["Recall: Query ChromaDB"]
        OODA -->|Decide| Lock{"The Conch (Mutex)"}
        Lock -->|Acquire| LLM["LLM Synthesis"]
        LLM -->|Draft| Ego["Integrity (Ego Filter)"]
        Ego -->|Act| EventBus
    end

    subgraph "The Mutable Soul"
        JSON["soul_state.json"]
        Vector["ChromaDB — Subjective Memory"]
        Recall -->|Query| Vector
        OODA -->|Read State| JSON
    end

    subgraph "CONSEQUENCE PHASE — Physics Engine"
        EventBus -->|AGENT_SPEAK| PhysicsSys["Physics System (Listener)"]
        PhysicsSys -->|calculate_impact| PhysicsUA["World Impact"]
        PhysicsUA -->|Stats + Goals| JSON
        
        PhysicsSys -->|calculate_reaction| PhysicsAA["Relationship Update"]
        PhysicsAA -->|Trust Deltas| JSON

        PhysicsSys -->|adjudicate_narrative| GM["Gamemaster Loop"]
        GM -->|Goal Progress| JSON
    end

    subgraph "REFLECTION PHASE — End of Session"
        EndSession["end session"] --> Dream["Dream Phase"]
        Dream -->|Trust Deltas Injected| Diary["Subjective Diary Entry"]
        Diary -->|Store| Vector
        Diary --> Agenda["review_agendas — Hidden Agenda Re-evaluation"]
        Agenda -->|Updated Agendas| JSON
    end

    subgraph "VISUAL LAYER — Optional"
        Server["FastAPI + WebSocket — server.py"]
        UI["React Frontend — localhost:5173"]
        Server <-->|Real-time Streaming| UI
        UI --> Graph["Syndicate Graph — Trust Network"]
        UI --> Thread["Thread View — Public + Spoiler"]
        UI --> Stats["Agent Stats Sidebar"]
    end

    EventBus <-->|WebSocket| Server

    style PhysicsUA fill:#e6f3ff,stroke:#1a73e8
    style Reconcile fill:#fff3e0,stroke:#e65100
    style Dream fill:#e8f5e9,stroke:#2e7d32
    style Ego fill:#fce4ec,stroke:#c62828
