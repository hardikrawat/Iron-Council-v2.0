# ===================================
# IRON COUNCIL v2.0 - Configuration
# ===================================
# Copy this file to .env and add your actual API keys

# --- Cloud LLM Providers ---
# OpenAI Configuration
OPENAI_API_KEY=sk-your-key-here

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Mistral Configuration (optional)
MISTRAL_API_KEY=your-mistral-key-here

# --- Local LLM Configuration (Ollama) ---
# Set LLM_PROVIDER to 'local' to use Ollama instead of cloud APIs
LLM_PROVIDER=local
LOCAL_LLM_URL=http://localhost:11434/api/chat
LOCAL_MODEL_NAME=qwen2.5:7b

# --- Agent-Specific Model Overrides (all should be same for now until individual model mechanisms are implemented / WIP)  ---
GENERAL_ARES_MODEL=qwen2.5:7b
DIPLOMAT_DOVE_MODEL=qwen2.5:7b
BANKER_MIDAS_MODEL=qwen2.5:7b
ANALYST_LOGIC_MODEL=qwen2.5:7b

# Turso DB Configuration (Remote Memory Storage)
TURSO_DB_URL=libsql://your-db-name.turso.io
TURSO_DB_TOKEN=your-auth-token-here

# --- Application Settings ---
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# LLM request timeout in seconds (increase for local models)
LLM_TIMEOUT=120
